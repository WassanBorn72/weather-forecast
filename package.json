{
  "name": "weather-forecast",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "node --watch --use-env-proxy --import tsx scripts/dev-api.ts",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "test": "vitest run",
    "test:ui": "playwright test",
    "db:migrate": "wrangler d1 migrations apply weather-forecast --local",
    "db:migrate:remote": "wrangler d1 migrations apply weather-forecast --remote",
    "deploy:api": "wrangler deploy",
    "deploy:web": "npm run build && wrangler pages deploy dist",
    "check:api": "node --use-env-proxy --import tsx scripts/check-api.ts",
    "dev:api:worker": "wrangler dev --ip 127.0.0.1 --port 8787",
    "collect": "node --use-env-proxy --import tsx scripts/collect.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "setup:dev": "node scripts/init-dev.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=24.5.0"
  }
}
